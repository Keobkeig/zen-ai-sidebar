{
  "manifest_version": 3,
  "name": "Zen AI Sidebar",
  "version": "1.1.0",
  "description": "AI-powered sidebar for Chrome using Gemini API. Summarize pages, explain selections, and ask contextual questions.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "action": {
    "default_title": "Zen AI"
  },
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Toggle Zen AI Sidebar"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "sidePanel",
    "nativeMessaging"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/browser-api.js", "content/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["shared/browser-api.js", "content/youtube-transcript.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  }
}
